# ============================================================
#  CONFIG DA AUTOMACAO META ADS  -  copie para .env e preencha
#  NUNCA suba o .env preenchido no GitHub / nunca compartilhe o token.
#  Cada aluno gera o SEU proprio token (veja o GUIA_ALUNO.md).
# ============================================================

# Token System User PERMANENTE (nao expira). Gerado no Business Settings da Meta.
META_ADS_TOKEN=COLE_AQUI_O_SEU_TOKEN

# Sua conta de anuncio (aparece no Gerenciador). Formato: act_XXXXXXXXXX
META_AD_ACCOUNT=act_000000000000

# App criado no Meta for Developers (so o numero do App ID).
META_APP_ID=000000000000

# (opcional) ID da campanha que voce vai acompanhar no dashboard.
META_CAMPANHA_ID=
